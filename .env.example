# Credentials stay out of config.json so it can be committed.
# The variable name is MESHQUAL_MQTT_<SOURCE_ID_UPPERCASED>_<FIELD>.

POSTGRES_PASSWORD=change-me
MESHQUAL_DSN=postgres://meshqual:change-me@timescale:5432/meshqual?sslmode=disable

MESHQUAL_API_URL=http://localhost:8080
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Public community broker (read-only credentials published by comchan.net).
MESHQUAL_MQTT_COMCHAN_USERNAME=mc_uplink
MESHQUAL_MQTT_COMCHAN_PASSWORD=mc_uplink

# Your own broker, if you run observers.
# MESHQUAL_MQTT_LOCAL_URL=mqtt://mosquitto:1884
# MESHQUAL_MQTT_LOCAL_USERNAME=
# MESHQUAL_MQTT_LOCAL_PASSWORD=

MESHQUAL_LOG_LEVEL=info
MESHQUAL_CORS_ORIGINS=http://localhost:5173
