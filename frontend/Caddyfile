:8081 {
	root * /srv
	encode zstd gzip

	# The API and the SSE stream share the frontend's origin, so the browser never
	# makes a cross-origin EventSource and no CORS headers are needed in production.
	handle /api/* {
		reverse_proxy relayd:8080 {
			# SSE must not be buffered, and the stream is long-lived.
			flush_interval -1
		}
	}

	handle {
		try_files {path} /index.html
		file_server
	}

	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
}
